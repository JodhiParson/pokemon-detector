{
  "manifest_version": 3,
  "name": "Pokemon Card Listing Detector",
  "version": "0.1.0",
  "description": "Detects when an eBay listing is a Pokemon card.",
  "content_scripts": [
    {
      "matches": ["*://*.ebay.com/itm/*"],
      "js": ["selectors.js", "detector.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
